# Wary — Environment Variables Configuration
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env or API keys into git.

# Firebase Project Configuration (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase App Check Configuration
# For production: reCAPTCHA v3 site key
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here

# For local evaluation / development by judges:
# Set to 'true' to generate a debug token in the browser console.
# Register that token in Firebase Console > App Check > Apps > Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=true
